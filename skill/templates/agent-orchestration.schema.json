{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Orchestration Plan",
  "type": "object",
  "required": ["goal", "roles", "tasks", "termination", "authority"],
  "properties": {
    "goal": {"type": "string"},
    "roles": {"type": "array", "items": {"type": "object", "required": ["id", "role"], "properties": {"id": {"type": "string"}, "role": {"type": "string"}, "capabilities": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "tasks": {"type": "array", "items": {"type": "object", "required": ["id", "objective", "dependencies"], "properties": {"id": {"type": "string"}, "objective": {"type": "string"}, "dependencies": {"type": "array", "items": {"type": "string"}}, "parallelizable": {"type": "boolean"}, "model_route": {"type": "string"}}, "additionalProperties": false}},
    "limits": {"type": "object", "properties": {"max_concurrency": {"type": "integer", "minimum": 1}, "max_depth": {"type": "integer", "minimum": 0}, "budget": {"type": "string"}}, "additionalProperties": false},
    "termination": {"type": "array", "items": {"type": "string"}},
    "authority": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
