{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synchronized Portfolio View Manifest",
  "type": "object",
  "required": ["schema_version", "portfolio_id", "authoritative_revision", "views"],
  "properties": {
    "schema_version": {"type": "string"},
    "portfolio_id": {"type": "string", "minLength": 1},
    "authoritative_revision": {"type": "string", "minLength": 1},
    "views": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["view_id", "view_type", "revision", "node_ids"],
        "properties": {
          "view_id": {"type": "string"},
          "view_type": {"enum": ["portfolio", "phase", "today"]},
          "revision": {"type": "string"},
          "node_ids": {"type": "array", "items": {"type": "string"}},
          "generated_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
